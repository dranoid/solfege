# Copy to .env and edit, then run:  uvicorn main:app --env-file .env --reload --port 8000
# (.env is git-ignored / personal; .env.example is the template to copy.)
# Note: --reload watches .py files, NOT .env — restart uvicorn after editing this.

# Which OMR engine to use: audiveris (default, best for SATB) or oemer
OMR_ENGINE=audiveris

# Full path to the Audiveris launcher produced by the build.
# Find it with:  find ~/audiveris -path '*/install/*/bin/Audiveris'
AUDIVERIS_CMD=/Users/cable/audiveris/app/build/install/app/bin/Audiveris

# JDK 25 home — Audiveris is built for Java 25, but your PATH `java` may be older.
# Setting this here guarantees the backend runs it under 25, whatever shell starts uvicorn.
# Get the value with:  /usr/libexec/java_home -v 25
JAVA_HOME=/Library/Java/JavaVirtualMachines/temurin-25.jdk/Contents/Home

# OCR language data for Audiveris (used for lyrics/text recognition).
# Install with:  brew install tesseract tesseract-lang
TESSDATA_PREFIX=/opt/homebrew/share/tessdata

# Seconds before a transcription is abandoned (OMR is slow on big scores)
OMR_TIMEOUT=900

# CORS: leave * for local use; tighten if you ever expose this beyond your machine
CORS_ORIGINS=*
