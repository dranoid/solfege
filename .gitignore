# ---- Node / Playwright ----
node_modules/
npm-debug.log*
yarn-error.log*
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# ---- Python (backend) ----
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ---- Secrets / local config ----
# Keep .env.example tracked; ignore the real, machine-specific .env
.env
.env.local
!.env.example

# ---- User-supplied audio assets (CC0 choir samples dropped in by the user) ----
samples/choir/*.mp3
samples/choir/*.wav
samples/choir/*.ogg

# ---- Local OMR test inputs (hymn PDFs / personal photos), not for the repo ----
tests/fixtures/
test-oworship.jpeg

# ---- Local dev scratch (kept out of the public repo) ----
prompt.txt

# ---- OS / editor cruft ----
.DS_Store
Thumbs.db
*.swp
*~
.idea/
